  "settings": [
    {
      "name": "leftPort",
      "display": "Left Port",
      "type": "enum",
      "options": [
        "joypad",
        "none",
        "multitap"
      ],
      "default": "joypad",
      "description": "What is plugged into the console's left controller port. A multitap carries pads P1 to P4 and pushes the right port's pads after them."
    },
    {
      "name": "rightPort",
      "display": "Right Port",
      "type": "enum",
      "options": [
        "joypad",
        "none",
        "multitap",
        "mouse",
        "superScope",
        "justifier"
      ],
      "default": "joypad",
      "description": "What is plugged into the console's right controller port."
    }
