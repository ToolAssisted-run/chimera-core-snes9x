{
  "coreName": "Snes9x",
  "systemId": "SNES",
  "author": "Snes9x team; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-snes9x",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    64,
    4,
    8,
    4,
    64
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. Snes9x mallocs ROM storage (~32MB), screen buffers and tile caches; big blocks land on the mmap heap.",
  "video": {
    "_comment": "buffer CAPACITY; the live size comes from GetVideoWidth/Height per frame (256x224 normally, 512x448 hires/interlace).",
    "width": 512,
    "height": 478,
    "virtualWidth": 293,
    "virtualHeight": 224,
    "vsyncNumerator": 21477272,
    "vsyncDenominator": 357366,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 4096,
    "channels": 2,
    "get": "GetAudio"
  },
  "input": {
    "name": "SNES Controller",
    "_comment": "index order is the wire format: Power (hard reset), Reset, P1..P8 pads in quickerSnes9x's .sol column order, then the right-port devices (mouse buttons, Super Scope, Justifier). Wider than 64, so everything rides the SetButton channel; the mouse deltas and gun pointers ride SetAxis. Which blocks are live follows the port settings.",
    "buttons": [
      "Power",
      "Reset",
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Select",
